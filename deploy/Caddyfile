# Caddy reverse proxy for erp.zavora.ai
# - Terminates HTTPS with an automatic Let's Encrypt certificate (issued once
#   DNS for erp.zavora.ai points at this server's public IP).
# - Proxies API calls (/api/*) to the api container on :8080.
# - Serves the built React SPA for everything else, with history-API fallback.

erp.zavora.ai {
	encode gzip zstd

	# API → backend. The UI calls /api/v1/...; the backend routes are under
	# /api/v1 as well, so pass the path through unchanged.
	handle /api/* {
		reverse_proxy api:8080
	}

	# Health check passthrough (no /api prefix on the backend health route).
	handle /health {
		reverse_proxy api:8080
	}

	# Static SPA.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
