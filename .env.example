# Zavora ERP — Environment Configuration

# Database
DATABASE_URL=postgres://zavora:zavora@localhost:5432/zavora_era

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Server
BIND_ADDR=0.0.0.0:8080

# Startup/bootstrap entity for the legacy single-tenant `register` path. Backgr-
# ound schedulers iterate ALL tenants regardless of this value. Set a stable UUID
# so the bootstrap path is deterministic across restarts; if unset a random UUID
# is generated each boot (fine for fresh dev installs, not for persistent data).
# ENTITY_ID=00000000-0000-0000-0000-000000000001

# Logging
RUST_LOG=zavora_erp_api=debug,zavora_erp_core=debug,tower_http=info

# Environment: set to "production" to require the JWT secrets below (fail-fast).
APP_ENV=development

# Auth — JWT signing keys. REQUIRED in production. Each must be >= 16 characters
# and the access/refresh secrets MUST differ. Generate with e.g.:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Token lifetimes in seconds (defaults: 900 = 15 min access, 604800 = 7 day refresh)
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=604800

# Platform Super Admin (Zavora ops plane). On API startup, if both are set and
# no platform_users row exists for the email, a Super Admin is created.
# Never use tenant Owner credentials here. Leave unset to skip bootstrap.
# PLATFORM_BOOTSTRAP_EMAIL=ops@zavora.ai
# PLATFORM_BOOTSTRAP_PASSWORD=change-me-long-secret
# PLATFORM_BOOTSTRAP_NAME=Platform Super Admin

# OCR receipt capture. The default provider is "manual" — receipts are stored
# and previewed, and the reviewer types/corrects the fields (no external
# service required). To enable real extraction, run an xberg OCR sidecar
# (`xberg serve`, configured with a LOCAL OCR backend so receipt images never
# leave your deployment) and point the API at it:
#   OCR_PROVIDER=xberg
#   XBERG_URL=http://127.0.0.1:8000
#   XBERG_OCR_TIMEOUT_SECS=30
# If OCR_PROVIDER=xberg but XBERG_URL is unset, or the sidecar is unreachable,
# the system degrades gracefully to manual review.
# OCR_PROVIDER=manual

# Local PDF text extraction (Pdfium). Digital bank statements and supplier
# invoices (the common case in Kenya) carry a real text layer that is read
# in-process — no OCR sidecar needed. This powers PDF bank-statement import
# (extract → review → confirm) and PDF receipt capture, both fully offline.
# Excel/ODS statements (e.g. M-Pesa full statement, bank .xlsx exports) are read
# directly with no extra dependency.
# The libpdfium dynamic library must be present at runtime. Get a prebuilt binary
# from https://github.com/bblanchon/pdfium-binaries and point PDFIUM_LIB_PATH at
# either the library FILE or the FOLDER that contains it. If unset, the system
# library is tried; if Pdfium can't be found, PDF extraction falls back to the
# xberg OCR sidecar (above), and only scanned (image-only) PDFs then require it.
# PDFIUM_LIB_PATH=/opt/pdfium/lib/libpdfium.so

# Notification delivery. Each channel is optional. Providers can be configured
# per deployment via the env vars below AND/OR per tenant in Settings →
# Providers (the tenant's own config takes precedence, with these as fallback).
#
# NOTIF_ENC_KEY encrypts per-tenant provider secrets at rest (AES-256-GCM).
# REQUIRED to store secrets via the UI. Generate with: openssl rand -base64 32
# NOTIF_ENC_KEY=
#
# The deployment-wide (fallback) provider env vars. When a tenant has not
# configured its own provider for a channel, these are used; if neither is set
# the channel reports "not configured". The worker logs which are live at startup.
#
# Email (SMTP) — already supported:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@zavora.app
#
# SMS — Africa's Talking (Kenyan SMS gateway). Use username "sandbox" for the
# sandbox endpoint. AT_SENDER_ID is optional (a registered alphanumeric/short code).
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=
# AT_BASE_URL=            # override endpoint (defaults: prod, or sandbox when AT_USERNAME=sandbox)
#
# WhatsApp — Twilio. TWILIO_WHATSAPP_FROM is your Twilio WhatsApp sender, e.g.
# whatsapp:+14155238886 (the "whatsapp:" prefix is added automatically if omitted).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=

# M-Pesa STK Push (Safaricom Daraja). Deployment-level credentials issued per
# shortcode. When unset, POST /payments/mpesa-stk-push returns a clear "not
# configured" error. MPESA_ENV=production selects the production host (default
# sandbox). MPESA_CALLBACK_URL must be publicly reachable by Safaricom.
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://your-host/api/v1/payments/mpesa-callback
# MPESA_ENV=sandbox

# Public base URL used to build customer-facing invoice pay links in emails
# (e.g. https://erp.zavora.ai). Unset in dev → email pay button is omitted.
PUBLIC_BASE_URL=
