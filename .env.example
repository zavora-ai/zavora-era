# Zavora ERP — Environment Configuration

# Database
DATABASE_URL=postgres://zavora:zavora@localhost:5432/zavora_era

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Server
BIND_ADDR=0.0.0.0:8080

# Startup/bootstrap entity for the legacy single-tenant `register` path. Backgr-
# ound schedulers iterate ALL tenants regardless of this value. Set a stable UUID
# so the bootstrap path is deterministic across restarts; if unset a random UUID
# is generated each boot (fine for fresh dev installs, not for persistent data).
# ENTITY_ID=00000000-0000-0000-0000-000000000001

# Logging
RUST_LOG=zavora_erp_api=debug,zavora_erp_core=debug,tower_http=info

# Environment: set to "production" to require the JWT secrets below (fail-fast).
APP_ENV=development

# Auth — JWT signing keys. REQUIRED in production. Each must be >= 16 characters
# and the access/refresh secrets MUST differ. Generate with e.g.:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Token lifetimes in seconds (defaults: 900 = 15 min access, 604800 = 7 day refresh)
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=604800

# OCR receipt capture. The default provider is "manual" — receipts are stored
# and previewed, and the reviewer types/corrects the fields (no external
# service required). To enable real extraction, run an xberg OCR sidecar
# (`xberg serve`, configured with a LOCAL OCR backend so receipt images never
# leave your deployment) and point the API at it:
#   OCR_PROVIDER=xberg
#   XBERG_URL=http://127.0.0.1:8000
#   XBERG_OCR_TIMEOUT_SECS=30
# If OCR_PROVIDER=xberg but XBERG_URL is unset, or the sidecar is unreachable,
# the system degrades gracefully to manual review.
# OCR_PROVIDER=manual

# Notification delivery. Each channel is optional and configured per deployment;
# when a channel's variables are unset the worker logs it and that channel
# reports "not configured" (InApp and queuing always work). The worker logs
# which channels are live at startup.
#
# Email (SMTP) — already supported:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@zavora.app
#
# SMS — Africa's Talking (Kenyan SMS gateway). Use username "sandbox" for the
# sandbox endpoint. AT_SENDER_ID is optional (a registered alphanumeric/short code).
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=
# AT_BASE_URL=            # override endpoint (defaults: prod, or sandbox when AT_USERNAME=sandbox)
#
# WhatsApp — Twilio. TWILIO_WHATSAPP_FROM is your Twilio WhatsApp sender, e.g.
# whatsapp:+14155238886 (the "whatsapp:" prefix is added automatically if omitted).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
